{
  "standard-harness-post-edit-linter": {
    "enabled": true,
    "postToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "command": ".agents/plugins/standard-harness/scripts/post-edit-lint.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
